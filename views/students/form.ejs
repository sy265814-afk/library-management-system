<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="form-page">
  <div class="form-page-heading"><div><div class="eyebrow"><%= mode === 'create' ? 'NEW RECORD' : 'UPDATE RECORD' %></div><h2><%= mode === 'create' ? 'Add student' : 'Edit student' %></h2><p>Create the student record and optionally assign a seat.</p></div><a href="/admin/students" class="back-link">← Back</a></div>
  <form class="large-form" method="POST" action="<%= mode === 'create' ? '/admin/students' : '/admin/students/' + student._id + '?_method=PUT' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-section"><h3>Student information</h3><div class="two-col"><label class="form-field"><span>Student ID</span><input name="studentId" required value="<%= student?.studentId || '' %>" placeholder="e.g. STU-001" maxlength="50"></label><label class="form-field"><span>Full name</span><input name="name" required value="<%= student?.name || '' %>" placeholder="Student full name"></label><label class="form-field"><span>Email</span><input type="email" name="email" value="<%= student?.email || '' %>" placeholder="student@example.com" maxlength="150"></label><label class="form-field"><span>Phone</span><input name="phone" value="<%= student?.phone || '' %>" placeholder="Mobile number"></label><label class="form-field"><span>Course</span><input name="course" value="<%= student?.course || '' %>" placeholder="B.Tech / BCA / etc."></label><label class="form-field"><span>Semester</span><input name="semester" value="<%= student?.semester || '' %>" placeholder="Semester"></label></div></div>
    <div class="form-section"><h3>Seat assignment</h3><label class="form-field"><span>Available seat</span><select name="seatId"><option value="">No seat assigned</option><% seats.forEach(seat => { %><option value="<%= seat._id %>" <%= student?.seat?._id?.toString() === seat._id.toString() ? 'selected' : '' %>><%= seat.seatNumber %> · <%= seat.floor %> · <%= seat.section %></option><% }) %></select></label></div>
    <div class="form-actions"><a href="/admin/students" class="button secondary">Cancel</a><button class="button primary-small" type="submit"><%= mode === 'create' ? 'Create student' : 'Save changes' %> →</button></div>
  </form>
</div>
<%- include('../partials/adminEnd') %>
