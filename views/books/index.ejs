<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="page-toolbar"><p class="page-subtitle">Manage your library catalogue and copy availability.</p><a href="/admin/books/new" class="button primary-small">+ Add book</a></div>
<div class="table-card"><table><thead><tr><th>Book</th><th>Author</th><th>Category</th><th>Copies</th><th>Availability</th><th>Actions</th></tr></thead><tbody>
<% if (!books.length) { %><tr><td colspan="6"><div class="empty-state"><b>No books yet</b><span>Add your first book to the catalogue.</span></div></td></tr><% } %>
<% books.forEach(book => { %><tr><td><strong><%= book.title %></strong><small><%= book.isbn || 'No ISBN' %></small></td><td><%= book.author %></td><td><%= book.category || '—' %></td><td><strong><%= book.totalCopies %></strong></td><td><span class="status-chip <%= book.availableCopies ? 'green' : 'muted' %>"><%= book.availableCopies %> available</span></td><td><div class="actions"><a href="/admin/books/<%= book._id %>/edit">Edit</a><form method="POST" action="/admin/books/<%= book._id %>?_method=DELETE" onsubmit="return confirm('Delete this book?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Delete</button></form></div></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/adminEnd') %>
