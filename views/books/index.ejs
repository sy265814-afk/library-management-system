<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="page-toolbar"><p class="page-subtitle">Manage the complete book catalogue and copy availability.</p><a href="/admin/books/new" class="button primary-small">+ Add book</a></div>
<div class="mini-stats-grid"><div><span>Total book copies</span><strong><%= inventory.totalCopies.toLocaleString('en-IN') %></strong></div><div><span>Available copies</span><strong><%= inventory.availableCopies.toLocaleString('en-IN') %></strong></div><div><span>Issued copies</span><strong><%= Math.max(0, inventory.totalCopies - inventory.availableCopies).toLocaleString('en-IN') %></strong></div></div>
<form class="list-filter" method="GET" action="/admin/books"><input type="search" name="q" value="<%= search %>" placeholder="Search by title, author, ISBN or category"><button class="button primary-small" type="submit">Search</button><% if (search) { %><a class="filter-clear" href="/admin/books">Clear</a><% } %></form>
<div class="table-card"><table><thead><tr><th>Book</th><th>Author</th><th>Category</th><th>Total copies</th><th>Available</th><th>Issued</th><th>Actions</th></tr></thead><tbody>
<% if (!books.length) { %><tr><td colspan="7"><div class="empty-state"><b>No books found</b><span>Add a new book or change your search.</span></div></td></tr><% } %>
<% books.forEach(book => { %><tr><td><strong><%= book.title %></strong><small><%= book.isbn || 'ISBN not added' %></small></td><td><%= book.author %></td><td><%= book.category || '—' %></td><td><strong><%= book.totalCopies %></strong></td><td><span class="status-chip <%= book.availableCopies ? 'green' : 'muted' %>"><%= book.availableCopies %></span></td><td><%= Math.max(0, book.totalCopies - book.availableCopies) %></td><td><div class="actions"><a href="/admin/books/<%= book._id %>/edit">Edit</a><form method="POST" action="/admin/books/<%= book._id %>?_method=DELETE" onsubmit="return confirm('Delete this book?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Delete</button></form></div></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/pagination') %>
<%- include('../partials/adminEnd') %>
