<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="form-page"><div class="form-page-heading"><div><div class="eyebrow"><%= mode === 'create' ? 'NEW BOOK' : 'UPDATE BOOK' %></div><h2><%= mode === 'create' ? 'Add book' : 'Edit book' %></h2><p>Keep your catalogue accurate and ready for issue.</p></div><a href="/admin/books" class="back-link">← Back</a></div>
<form class="large-form" method="POST" action="<%= mode === 'create' ? '/admin/books' : '/admin/books/' + book._id + '?_method=PUT' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-section"><div class="two-col"><label class="form-field"><span>Book title</span><input name="title" required value="<%= book?.title || '' %>" placeholder="Book title"></label><label class="form-field"><span>Author</span><input name="author" required value="<%= book?.author || '' %>" placeholder="Author name"></label><label class="form-field"><span>ISBN</span><input name="isbn" value="<%= book?.isbn || '' %>" placeholder="ISBN"></label><label class="form-field"><span>Category</span><input name="category" value="<%= book?.category || '' %>" placeholder="Programming"></label><label class="form-field"><span>Publisher</span><input name="publisher" value="<%= book?.publisher || '' %>" placeholder="Publisher"></label><label class="form-field"><span>Total copies</span><input type="number" min="0" max="1000000" name="totalCopies" required value="<%= book?.totalCopies ?? 1 %>"></label></div></div><div class="form-actions"><a href="/admin/books" class="button secondary">Cancel</a><button class="button primary-small" type="submit"><%= mode === 'create' ? 'Add book' : 'Save changes' %> →</button></div></form></div>
<%- include('../partials/adminEnd') %>
