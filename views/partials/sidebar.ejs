<aside class="sidebar">
  <a href="/admin" class="brand">
    <span class="brand-mark">L</span>
    <span><strong>LibraryOS</strong><small>LIBRARY OPERATIONS</small></span>
  </a>

  <div class="sidebar-label">Workspace</div>
  <nav class="nav-list">
    <a href="/admin" class="nav-link">⌂ <span>Dashboard</span></a>
    <a href="/admin/students" class="nav-link">◉ <span>Students</span></a>
    <a href="/admin/seats" class="nav-link">▦ <span>Seats</span></a>
    <a href="/admin/books" class="nav-link">▤ <span>Books</span></a>
    <a href="/admin/issues" class="nav-link">↗ <span>Issue & Return</span></a>
  </nav>

  <div class="sidebar-bottom">
    <div class="mini-profile">
      <span><%= (admin?.name || 'A').slice(0, 1).toUpperCase() %></span>
      <div><strong><%= admin?.name || 'Administrator' %></strong><small><%= admin?.username || '' %></small></div>
    </div>
    <form method="POST" action="/admin/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="logout-button" type="submit">↪ Sign out</button>
    </form>
  </div>
</aside>
