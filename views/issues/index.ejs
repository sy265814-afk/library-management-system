<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="page-toolbar"><p class="page-subtitle">Track issued books, due dates, returns and complete issue history.</p><a href="/admin/issues/new" class="button primary-small">+ Issue book</a></div>
<form class="list-filter" method="GET" action="/admin/issues"><input type="search" name="q" value="<%= search %>" placeholder="Search student, book title or ID"><select name="status"><option value="">All records</option><option value="ISSUED" <%= status === 'ISSUED' ? 'selected' : '' %>>Currently issued</option><option value="RETURNED" <%= status === 'RETURNED' ? 'selected' : '' %>>Returned</option></select><button class="button primary-small" type="submit">Filter</button><a class="filter-clear" href="/admin/issues">Clear</a></form>
<div class="table-card"><table><thead><tr><th>Student</th><th>Book</th><th>Issued date</th><th>Due date</th><th>Status</th><th>Action</th></tr></thead><tbody>
<% if (!issues.length) { %><tr><td colspan="6"><div class="empty-state"><b>No issue records found</b><span>Issue a book or change your filters.</span></div></td></tr><% } %>
<% issues.forEach(issue => { %><tr><td><strong><%= issue.student?.name || 'Deleted student' %></strong><small><%= issue.student?.studentId || '' %></small></td><td><strong><%= issue.book?.title || 'Deleted book' %></strong><small><%= issue.book?.author || '' %></small></td><td><%= formatDate(issue.issuedAt) %></td><td><%= formatDate(issue.dueAt) %></td><td><span class="status-chip <%= issue.status === 'ISSUED' ? 'blue' : 'green' %>"><%= issue.status %></span></td><td><% if (issue.status === 'ISSUED') { %><form method="POST" action="/admin/issues/<%= issue._id %>/return?_method=PUT" onsubmit="return confirm('Confirm that this book has been returned?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-button" type="submit">Return book</button></form><% } else { %><span class="returned-date"><%= formatDate(issue.returnedAt) %></span><% } %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/pagination') %>
<%- include('../partials/adminEnd') %>
