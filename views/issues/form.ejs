<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="form-page"><div class="form-page-heading"><div><div class="eyebrow">NEW TRANSACTION</div><h2>Issue a book</h2><p>Select an active student, available book and due date.</p></div><a href="/admin/issues" class="back-link">← Back</a></div>
<form class="large-form" method="POST" action="/admin/issues"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-section"><div class="two-col"><label class="form-field"><span>Student</span><select name="studentId" required><option value="">Select student</option><% students.forEach(student => { %><option value="<%= student._id %>"><%= student.name %> · <%= student.studentId %></option><% }) %></select></label><label class="form-field"><span>Book</span><select name="bookId" required><option value="">Select available book</option><% books.forEach(book => { %><option value="<%= book._id %>"><%= book.title %> · <%= book.availableCopies %> available</option><% }) %></select></label><label class="form-field"><span>Due date</span><input type="date" name="dueAt" required></label></div></div><div class="form-actions"><a href="/admin/issues" class="button secondary">Cancel</a><button class="button primary-small" type="submit">Issue book →</button></div></form></div>
<%- include('../partials/adminEnd') %>
