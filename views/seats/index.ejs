<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="page-toolbar"><p class="page-subtitle">Create seats, monitor occupancy and release seats when a student leaves.</p><a href="/admin/seats/new" class="button primary-small">+ Add seat</a></div>
<div class="mini-stats-grid"><div><span>Available</span><strong><%= seatStats.available.toLocaleString('en-IN') %></strong></div><div><span>Occupied</span><strong><%= seatStats.occupied.toLocaleString('en-IN') %></strong></div><div><span>Maintenance</span><strong><%= seatStats.maintenance.toLocaleString('en-IN') %></strong></div></div>
<form class="list-filter" method="GET" action="/admin/seats"><input type="search" name="q" value="<%= search %>" placeholder="Search seat number"><select name="status"><option value="">All statuses</option><option value="AVAILABLE" <%= status === 'AVAILABLE' ? 'selected' : '' %>>Available</option><option value="OCCUPIED" <%= status === 'OCCUPIED' ? 'selected' : '' %>>Occupied</option><option value="MAINTENANCE" <%= status === 'MAINTENANCE' ? 'selected' : '' %>>Maintenance</option></select><button class="button primary-small" type="submit">Filter</button><a class="filter-clear" href="/admin/seats">Clear</a></form>
<div class="seat-grid">
<% if (!seats.length) { %><div class="empty-state large-empty"><b>No seats found</b><span>Add a seat or change your filter.</span></div><% } %>
<% seats.forEach(seat => { %>
  <div class="seat-card <%= seat.status.toLowerCase() %>"><div class="seat-top"><span class="seat-number"><%= seat.seatNumber %></span><span class="status-chip <%= seat.status === 'AVAILABLE' ? 'green' : seat.status === 'OCCUPIED' ? 'blue' : 'muted' %>"><%= seat.status %></span></div><h3><%= seat.section %></h3><p><%= seat.floor %></p><div class="seat-student"><%= seat.student ? 'Assigned to ' + seat.student.name + ' (' + seat.student.studentId + ')' : 'Ready for assignment' %></div><div class="actions"><a href="/admin/seats/<%= seat._id %>/edit">Edit</a><% if (seat.student) { %><form method="POST" action="/admin/seats/<%= seat._id %>/release" onsubmit="return confirm('Release this seat from the assigned student?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="release-button">Release seat</button></form><% } else { %><form method="POST" action="/admin/seats/<%= seat._id %>?_method=DELETE" onsubmit="return confirm('Delete this seat?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Delete</button></form><% } %></div></div>
<% }) %>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/adminEnd') %>
