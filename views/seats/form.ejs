<%- include('../partials/head') %>
<%- include('../partials/adminStart') %>
<div class="form-page"><div class="form-page-heading"><div><div class="eyebrow"><%= mode === 'create' ? 'NEW SEAT' : 'UPDATE SEAT' %></div><h2><%= mode === 'create' ? 'Add library seat' : 'Edit library seat' %></h2><p>Keep your seating plan organised and easy to assign.</p></div><a href="/admin/seats" class="back-link">← Back</a></div>
<form class="large-form" method="POST" action="<%= mode === 'create' ? '/admin/seats' : '/admin/seats/' + seat._id + '?_method=PUT' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-section"><div class="two-col"><label class="form-field"><span>Seat number</span><input name="seatNumber" required value="<%= seat?.seatNumber || '' %>" placeholder="A-01"></label><label class="form-field"><span>Section</span><input name="section" value="<%= seat?.section || 'General' %>" placeholder="General"></label><label class="form-field"><span>Floor</span><input name="floor" value="<%= seat?.floor || 'Ground Floor' %>" placeholder="Ground Floor"></label><% if (mode === 'create' || !seat?.student) { %><label class="form-field"><span>Status</span><select name="status"><option value="AVAILABLE" <%= seat?.status === 'AVAILABLE' || !seat ? 'selected' : '' %>>Available</option><option value="MAINTENANCE" <%= seat?.status === 'MAINTENANCE' ? 'selected' : '' %>>Maintenance</option></select></label><% } %></div></div><div class="form-actions"><a href="/admin/seats" class="button secondary">Cancel</a><button class="button primary-small" type="submit"><%= mode === 'create' ? 'Create seat' : 'Save changes' %> →</button></div></form></div>
<%- include('../partials/adminEnd') %>
